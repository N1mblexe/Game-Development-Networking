---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Module accent color for this page. */
  accent?: string;
  /** Wider main column (dashboards, playground). */
  wide?: boolean;
}
const { title, description = 'Interactive course: game networking, Unity Netcode for GameObjects and Steam.', accent, wide } = Astro.props;
const fullTitle = title === 'NetLearn' ? title : `${title} · NetLearn`;
---

<!doctype html>
<html lang="en" data-theme="light" style={accent ? `--module: ${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <script is:inline>
      (function () {
        var t;
        try {
          t = localStorage.getItem('netlearn-theme');
        } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 btn">Skip to content</a>
    <Header />
    <main id="main" class:list={['mx-auto w-full flex-1 px-4 py-8 sm:px-6', wide ? 'max-w-7xl' : 'max-w-6xl']}>
      <slot />
    </main>
    <footer class="no-print border-t border-border py-6 text-center text-sm text-muted">
      NetLearn · progress is stored only in this browser · <a class="underline" href={withBase('/progress/')}>export or reset</a>
    </footer>
    <script>
      import '../scripts/progress-dom';
    </script>
  </body>
</html>
