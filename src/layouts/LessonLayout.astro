---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import LessonSidebar from '../components/layout/LessonSidebar.astro';
import QuizRunner from '../components/quiz/QuizRunner';
import {
  getLessons,
  getPrevNext,
  getQuiz,
  lessonUrl,
  lessonUrlFromKey,
  type LessonEntry,
  type ModuleEntry,
} from '../lib/content/nav';
import { getEntry } from 'astro:content';

interface Props {
  lesson: LessonEntry;
  module: ModuleEntry;
  headings: MarkdownHeading[];
}
const { lesson, module, headings } = Astro.props;
const d = lesson.data;
const moduleLessons = await getLessons(module.id);
const { prev, next } = await getPrevNext(lesson);
const quiz = await getQuiz(lesson.id);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const prereqs = await Promise.all(
  d.prerequisites.map(async (key) => ({ key, title: (await getEntry('lessons', key))?.data.title ?? key })),
);
const index = moduleLessons.findIndex((l) => l.id === lesson.id) + 1;
---

<BaseLayout title={d.title} description={d.summary} accent={module.data.color} wide>
  <div class="grid gap-8 lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_13rem]">
    <!-- Sidebar: sticky on desktop, collapsible on mobile -->
    <aside class="no-print">
      <details class="card p-3 lg:hidden">
        <summary class="cursor-pointer font-semibold">{module.data.title} · lesson {index} of {moduleLessons.length}</summary>
        <div class="mt-3"><LessonSidebar module={module} lessons={moduleLessons} currentId={lesson.id} /></div>
      </details>
      <div class="sticky top-20 hidden max-h-[calc(100dvh-6rem)] overflow-y-auto pr-2 lg:block">
        <LessonSidebar module={module} lessons={moduleLessons} currentId={lesson.id} />
      </div>
    </aside>

    <article class="min-w-0">
      <header class="mb-8 border-b border-border pb-6">
        <p class="mb-2 text-sm font-semibold" style={`color:${module.data.color}`}>
          {module.data.short} · Lesson {index}
        </p>
        <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl" data-pagefind-meta="title">{d.title}</h1>
        <p class="mt-3 text-lg text-muted">{d.summary}</p>
        <div class="mt-4 flex flex-wrap gap-2 text-xs">
          <span class="rounded-full bg-surface-2 px-2.5 py-1">⏱ {d.durationMin} min</span>
          {d.targets?.unity && <span class="rounded-full bg-surface-2 px-2.5 py-1">Unity {d.targets.unity}</span>}
          {d.targets?.packages.map((p) => <span class="rounded-full bg-surface-2 px-2.5 py-1 font-mono">{p.name} {p.version}</span>)}
        </div>

        <div class="mt-6 rounded-xl border border-border bg-surface p-4">
          <h2 class="mb-2 text-sm font-bold uppercase tracking-wider text-muted">You will learn to</h2>
          <ul class="list-disc space-y-1 pl-5">{d.objectives.map((o) => <li>{o}</li>)}</ul>
          {
            prereqs.length > 0 && (
              <p class="mt-3 text-sm text-muted">
                Before this: {prereqs.map((p, i) => (<>{i > 0 && ', '}<a class="text-accent underline" href={lessonUrlFromKey(p.key)}>{p.title}</a></>))}
              </p>
            )
          }
        </div>
      </header>

      <div class="prose" data-pagefind-body data-pagefind-filter={`module:${module.data.short}`} data-pagefind-meta={`module:${module.data.short}`}>
        <slot />
      </div>

      <section class="no-print mt-12" aria-labelledby="quiz-heading">
        <h2 id="quiz-heading" class="mb-4 text-2xl font-bold">Check your understanding</h2>
        {
          quiz ? (
            <QuizRunner client:visible lessonKey={lesson.id} questions={quiz.data.questions} passPct={quiz.data.passPct} />
          ) : (
            <p class="text-muted">No quiz for this lesson yet.</p>
          )
        }
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <button type="button" class="btn mark-complete" data-mark-complete={lesson.id} aria-pressed="false">
            <span aria-hidden="true">✓</span> <span data-label>Mark as complete</span>
          </button>
          <span class="text-sm text-muted">Passing the quiz at {quiz?.data.passPct ?? 70}% or more completes the lesson automatically.</span>
        </div>
      </section>

      {
        d.sources.length > 0 && (
          <section class="mt-10 text-sm">
            <h2 class="mb-2 font-bold">Sources & further reading</h2>
            <ul class="list-disc space-y-1 pl-5 text-muted">
              {d.sources.map((s) => (
                <li><a class="text-accent underline" href={s.url} rel="noopener">{s.title}</a></li>
              ))}
            </ul>
          </section>
        )
      }

      <nav class="no-print mt-12 grid gap-3 sm:grid-cols-2" aria-label="Lesson navigation">
        {prev ? (
          <a href={lessonUrl(prev)} class="card p-4 hover:border-accent">
            <span class="text-xs text-muted">← Previous</span>
            <span class="block font-semibold">{prev.data.title}</span>
          </a>
        ) : <span />}
        {next && (
          <a href={lessonUrl(next)} class="card p-4 text-right hover:border-accent">
            <span class="text-xs text-muted">Next →</span>
            <span class="block font-semibold">{next.data.title}</span>
          </a>
        )}
      </nav>
    </article>

    {
      toc.length > 0 && (
        <aside class="no-print hidden xl:block">
          <nav class="sticky top-20 text-sm" aria-label="On this page">
            <p class="mb-2 font-semibold">On this page</p>
            <ul class="space-y-1.5 border-l border-border">
              {toc.map((h) => (
                <li class:list={[h.depth === 3 ? 'pl-6' : 'pl-3']}>
                  <a href={`#${h.slug}`} class="text-muted hover:text-text">{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</BaseLayout>

<style>
  .mark-complete[data-done='true'] {
    background: var(--ok-soft);
    border-color: var(--ok);
    color: var(--ok);
  }
</style>
