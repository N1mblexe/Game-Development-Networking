---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import LessonSidebar from '../components/layout/LessonSidebar.astro';
import QuizRunner from '../components/quiz/QuizRunner';
import FallbackNotice from '../components/layout/FallbackNotice.astro';
import {
  getLesson,
  getLessons,
  getPrevNext,
  getQuiz,
  lessonUrl,
  lessonUrlFromKey,
  type LessonEntry,
  type ModuleEntry,
} from '../lib/content/nav';
import { DEFAULT_LOCALE, LOCALES } from '../i18n/locales';
import { getLocale } from '../lib/i18n/route';

interface Props {
  lesson: LessonEntry;
  module: ModuleEntry;
  headings: MarkdownHeading[];
  /** False on a translated page whose lesson isn't translated yet: the English body is shown as a fallback. */
  translated?: boolean;
}
const { lesson, module, headings, translated = true } = Astro.props;
const locale = getLocale(Astro);
const d = lesson.data;
const packageNotes = (d.targets?.packages ?? []).filter((p) => p.note);
const moduleLessons = await getLessons(module.id, locale);
const { prev, next } = await getPrevNext(lesson, locale);
const quiz = await getQuiz(lesson.id, locale);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const prereqs = await Promise.all(
  d.prerequisites.map(async (key) => ({ key, title: (await getLesson(key, locale))?.data.title ?? key })),
);
const index = moduleLessons.findIndex((l) => l.id === lesson.id) + 1;
// A fallback page points search engines at the English original and stays out of this locale's search index.
const canonical = translated ? undefined : new URL(lessonUrl(lesson, DEFAULT_LOCALE), Astro.site).href;
/** The fallback's English text is marked as English for screen readers, hyphenation and search. */
const fallbackLang = translated ? undefined : LOCALES[DEFAULT_LOCALE].htmlLang;
---

<BaseLayout title={d.title} description={d.summary} accent={module.data.color} wide canonical={canonical}>
  <div class="grid gap-8 lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_13rem]">
    <!-- Sidebar: sticky on desktop, collapsible on mobile -->
    <aside class="no-print">
      <details class="card p-3 lg:hidden">
        <summary class="cursor-pointer font-semibold">{module.data.title} · lesson {index} of {moduleLessons.length}</summary>
        <div class="mt-3"><LessonSidebar module={module} lessons={moduleLessons} currentId={lesson.id} /></div>
      </details>
      <div class="sticky top-20 hidden max-h-[calc(100dvh-6rem)] overflow-y-auto pr-2 lg:block">
        <LessonSidebar module={module} lessons={moduleLessons} currentId={lesson.id} />
      </div>
    </aside>

    <article class="min-w-0">
      <header class="mb-8 border-b border-border pb-6">
        <p class="text-module-ink mb-2 text-sm font-semibold" style={`--module:${module.data.color}`}>
          {module.data.short} · Lesson {index}
        </p>
        <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl" data-pagefind-meta="title" lang={fallbackLang}>{d.title}</h1>
        <p class="mt-3 text-lg text-muted" lang={fallbackLang}>{d.summary}</p>
        <div class="mt-4 flex flex-wrap gap-2 text-xs">
          <span class="rounded-full bg-surface-2 px-2.5 py-1">⏱ {d.durationMin} min</span>
          {d.targets?.unity && <span class="rounded-full bg-surface-2 px-2.5 py-1">Unity {d.targets.unity}</span>}
          {d.targets?.packages.map((p) => <span class="max-w-full rounded-2xl bg-surface-2 px-2.5 py-1 font-mono [overflow-wrap:anywhere]">{p.name} {p.version}</span>)}
        </div>
        {
          packageNotes.length > 0 && (
            <ul class="mt-2 space-y-0.5 text-xs text-muted [overflow-wrap:anywhere]">
              {packageNotes.map((p) => (
                <li>
                  <span class="font-mono">{p.name}</span>: {p.note}
                </li>
              ))}
            </ul>
          )
        }

        <div class="mt-6 rounded-xl border border-border bg-surface p-4">
          <h2 class="mb-2 text-sm font-bold uppercase tracking-wider text-muted">You will learn to</h2>
          <ul class="list-disc space-y-1 pl-5" lang={fallbackLang}>{d.objectives.map((o) => <li>{o}</li>)}</ul>
          {
            prereqs.length > 0 && (
              <p class="mt-3 text-sm text-muted">
                Before this: {prereqs.map((p, i) => (<>{i > 0 && ', '}<a class="text-accent underline" href={lessonUrlFromKey(p.key, locale)}>{p.title}</a></>))}
              </p>
            )
          }
        </div>
      </header>

      {!translated && <FallbackNotice />}
      <div
        class="prose"
        {...translated
          ? { 'data-pagefind-body': true, 'data-pagefind-filter': `module:${module.data.short}`, 'data-pagefind-meta': `module:${module.data.short}` }
          : { lang: fallbackLang }}
      >
        <slot />
      </div>

      <section class="no-print mt-12" aria-labelledby="quiz-heading">
        <h2 id="quiz-heading" class="mb-4 text-2xl font-bold">Check your understanding</h2>
        {
          quiz ? (
            <QuizRunner client:visible lessonKey={lesson.id} questions={quiz.data.questions} passPct={quiz.data.passPct} locale={locale} />
          ) : (
            <p class="text-muted">No quiz for this lesson yet.</p>
          )
        }
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <button type="button" class="btn mark-complete" data-mark-complete={lesson.id} aria-pressed="false">
            <span aria-hidden="true">✓</span> <span data-label>Mark as complete</span>
          </button>
          <span class="text-sm text-muted">Passing the quiz at {quiz?.data.passPct ?? 70}% or more completes the lesson automatically.</span>
        </div>
      </section>

      {
        d.sources.length > 0 && (
          <section class="mt-10 text-sm">
            <h2 class="mb-2 font-bold">Sources & further reading</h2>
            <ul class="list-disc space-y-1 pl-5 text-muted">
              {d.sources.map((s) => (
                <li><a class="text-accent underline" href={s.url} rel="noopener">{s.title}</a></li>
              ))}
            </ul>
          </section>
        )
      }

      <nav class="no-print mt-12 grid gap-3 sm:grid-cols-2" aria-label="Lesson navigation">
        {prev ? (
          <a href={lessonUrl(prev, locale)} class="card p-4 hover:border-accent">
            <span class="text-xs text-muted">← Previous</span>
            <span class="block font-semibold">{prev.data.title}</span>
          </a>
        ) : <span />}
        {next && (
          <a href={lessonUrl(next, locale)} class="card p-4 text-right hover:border-accent">
            <span class="text-xs text-muted">Next →</span>
            <span class="block font-semibold">{next.data.title}</span>
          </a>
        )}
      </nav>
    </article>

    {
      toc.length > 0 && (
        <aside class="no-print hidden xl:block">
          <nav class="sticky top-20 text-sm" aria-label="On this page">
            <p class="mb-2 font-semibold">On this page</p>
            <ul class="space-y-1.5 border-l border-border">
              {toc.map((h) => (
                <li class:list={[h.depth === 3 ? 'pl-6' : 'pl-3']}>
                  <a href={`#${h.slug}`} class="text-muted hover:text-text">{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</BaseLayout>

<style>
  .mark-complete[data-done='true'] {
    background: var(--ok-soft);
    border-color: var(--ok);
    color: var(--ok);
  }
</style>
