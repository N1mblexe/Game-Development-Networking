---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Certificate from '../../components/progress/Certificate';
import { examUrl, getLessons, getModules } from '../../lib/content/nav';

export async function getStaticPaths() {
  return (await getModules()).map((module) => ({ params: { module: module.id }, props: { module } }));
}

const { module } = Astro.props;
const lessons = await getLessons(module.id);
---

<BaseLayout title={`${module.data.title} certificate`} accent={module.data.color}>
  <Certificate
    client:load
    moduleId={module.id}
    moduleTitle={module.data.title}
    moduleColor={module.data.color}
    lessonKeys={lessons.map((l) => l.id)}
    examUrl={examUrl(module.id)}
  />
</BaseLayout>
