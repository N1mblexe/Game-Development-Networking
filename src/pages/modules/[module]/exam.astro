---
import { getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ExamRunner from '../../../components/quiz/ExamRunner';
import { certificateUrl, getModules, moduleUrl } from '../../../lib/content/nav';

export async function getStaticPaths() {
  return (await getModules()).map((module) => ({ params: { module: module.id }, props: { module } }));
}

const { module } = Astro.props;
const exam = await getEntry('exams', module.id);
---

<BaseLayout title={`${module.data.title} exam`} accent={module.data.color}>
  <p class="mb-2 text-sm"><a class="text-accent underline" href={moduleUrl(module.id)}>← {module.data.title}</a></p>
  <h1 class="mb-6 text-3xl font-extrabold tracking-tight">{exam?.data.title ?? `${module.data.title} exam`}</h1>
  {
    exam ? (
      <ExamRunner
        client:load
        moduleId={module.id}
        title={exam.data.title}
        questions={exam.data.questions}
        drawCount={exam.data.drawCount}
        passPct={exam.data.passPct}
        timeLimitMin={exam.data.timeLimitMin}
        certificateUrl={certificateUrl(module.id)}
      />
    ) : (
      <p class="text-muted">This module's exam hasn't been written yet.</p>
    )
  }
</BaseLayout>
