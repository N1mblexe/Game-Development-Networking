---
import { getEntry, render } from 'astro:content';
import LessonLayout from '../../../layouts/LessonLayout.astro';
import { mdxComponents } from '../../../components/mdx';
import { getLessons, lessonModule, lessonSlug } from '../../../lib/content/nav';

export async function getStaticPaths() {
  const lessons = await getLessons();
  return lessons.map((lesson) => ({
    params: { module: lessonModule(lesson), lesson: lessonSlug(lesson) },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const module = await getEntry('modules', lessonModule(lesson));
if (!module) throw new Error(`Lesson ${lesson.id} belongs to unknown module`);
const { Content, headings } = await render(lesson);
---

<LessonLayout lesson={lesson} module={module} headings={headings}>
  <Content components={mdxComponents} />
</LessonLayout>
