---
/**
 * Glossary: every term from src/content/glossary/*.yaml, grouped A–Z.
 * Filtering (text + module) is a small inline script; the page works fully without it.
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGlossary, getModules, lessonUrlFromKey } from '../lib/content/nav';

const glossary = await getGlossary();
const terms = [...glossary.values()].sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));
const modules = await getModules();
const moduleById = new Map(modules.map((m) => [m.id, m.data]));
const usedModules = modules.filter((m) => terms.some((t) => t.module === m.id));

/** Escape HTML, then render inline `code` and **bold** (the only formatting `long` supports). */
function inline(text: string): string {
  const esc = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  return esc.replace(/`([^`]+)`/g, '<code>$1</code>').replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}

const letterOf = (term: string) => {
  const c = term.trim()[0]?.toUpperCase() ?? '#';
  return /[A-Z]/.test(c) ? c : '#';
};

// Resolve "Taught in" lessons once (only lessons that exist get a link).
const lessonKeys = [...new Set(terms.map((t) => t.lesson).filter((k): k is string => Boolean(k)))];
const lessonTitles = new Map<string, string>();
for (const key of lessonKeys) {
  const entry = await getEntry('lessons', key);
  if (entry && (import.meta.env.DEV || !entry.data.draft)) lessonTitles.set(key, entry.data.title);
}

const groups = new Map<string, typeof terms>();
for (const t of terms) {
  const l = letterOf(t.term);
  if (!groups.has(l)) groups.set(l, []);
  groups.get(l)!.push(t);
}
const alphabet = ['#', ...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'];
const letterId = (l: string) => (l === '#' ? 'letter-num' : `letter-${l.toLowerCase()}`);
---

<BaseLayout title="Glossary" description="Every networking, Netcode for GameObjects and Steamworks term used in the course.">
  <div class="mx-auto max-w-4xl">
    <header class="mb-6">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Glossary</h1>
      <p class="mt-2 text-muted">
        {terms.length} terms used across the course. Hover or tap an underlined term in a lesson to see its definition there.
      </p>
    </header>

    <!-- Toolbar: sticky under the site header -->
    <div
      class="z-20 -mx-4 mb-6 sm:sticky sm:top-14 border-b border-border bg-bg/95 px-4 pt-3 pb-3 backdrop-blur sm:-mx-6 sm:px-6"
      data-pagefind-ignore
      data-glossary-toolbar
    >
      <div class="flex flex-wrap items-center gap-2">
        <label class="relative min-w-0 flex-1 basis-56">
          <span class="sr-only">Filter terms</span>
          <svg viewBox="0 0 24 24" class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-muted" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
          </svg>
          <input
            type="search"
            data-glossary-filter
            placeholder="Filter terms…  (press / )"
            autocomplete="off"
            spellcheck="false"
            class="w-full rounded-lg border border-border bg-surface py-2 pr-3 pl-9 text-sm placeholder:text-muted"
          />
        </label>
        <p class="text-sm whitespace-nowrap text-muted" aria-live="polite" data-glossary-count>{terms.length} terms</p>
      </div>
      <div class="mt-2 flex flex-wrap gap-1.5" role="group" aria-label="Filter by module">
        <button type="button" class="gl-chip" aria-pressed="true" data-module-chip="">All</button>
        {
          usedModules.map((m) => (
            <button type="button" class="gl-chip" aria-pressed="false" data-module-chip={m.id} style={`--chip:${m.data.color}`}>
              <span class="h-2 w-2 rounded-full" style={`background:${m.data.color}`} aria-hidden="true" />
              {m.data.short}
            </button>
          ))
        }
      </div>
      <nav class="mt-2 flex flex-wrap gap-0.5 font-mono text-sm" aria-label="Jump to letter">
        {
          alphabet.map((l) =>
            groups.has(l) ? (
              <a href={`#${letterId(l)}`} class="gl-letter" data-letter-link={l}>
                {l}
              </a>
            ) : (
              <span class="gl-letter gl-letter-off" aria-hidden="true">
                {l}
              </span>
            ),
          )
        }
      </nav>
    </div>

    <p class="hidden rounded-lg border border-dashed border-border p-6 text-center text-muted" data-glossary-empty>
      No terms match. <button type="button" class="text-accent underline" data-glossary-clear>Clear filters</button>
    </p>

    <div data-pagefind-body data-pagefind-filter="module:Glossary" data-pagefind-meta="title:Glossary">
      {
        [...groups.entries()].map(([letter, list]) => (
          <section class="mb-8" aria-labelledby={letterId(letter)} data-letter-section={letter}>
            <h2 id={letterId(letter)} class="mb-3 scroll-mt-20 sm:scroll-mt-60 border-b border-border pb-1 font-mono text-xl font-bold text-muted">
              {letter}
            </h2>
            <div class="grid gap-3">
              {list.map((t) => {
                const mod = moduleById.get(t.module);
                const seeAlso = t.seeAlso.filter((s) => glossary.has(s));
                const haystack = [t.term, t.id, ...t.aliases, t.short, t.long ?? ''].join(' ').toLowerCase();
                return (
                  <article class="gl-card card p-4 sm:p-5" data-term-card data-module={t.module} data-search={haystack}>
                    <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                      <h3 id={t.id} class="scroll-mt-20 sm:scroll-mt-60 text-lg font-bold">
                        <a href={`#${t.id}`} class="hover:text-accent">
                          {t.term}
                        </a>
                      </h3>
                      {t.aliases.length > 0 && <span class="text-sm text-muted">also {t.aliases.join(', ')}</span>}
                      {mod && (
                        <span
                          data-pagefind-ignore
                          class="ml-auto rounded-full border px-2 py-0.5 text-xs font-medium"
                          style={`color:${mod.color};border-color:color-mix(in srgb, ${mod.color} 45%, transparent)`}
                        >
                          {mod.short}
                        </span>
                      )}
                    </div>
                    <p class="gl-body mt-1.5 leading-relaxed" set:html={inline(t.long ?? t.short)} />
                    {(seeAlso.length > 0 || (t.lesson && lessonTitles.has(t.lesson))) && (
                      <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5 text-sm" data-pagefind-ignore>
                        {t.lesson && lessonTitles.has(t.lesson) && (
                          <span>
                            <span class="text-muted">Taught in </span>
                            <a class="font-medium text-accent hover:underline" href={lessonUrlFromKey(t.lesson)}>
                              {lessonTitles.get(t.lesson)} →
                            </a>
                          </span>
                        )}
                        {seeAlso.length > 0 && (
                          <span>
                            <span class="text-muted">See also </span>
                            {seeAlso.map((s, i) => (
                              <>
                                {i > 0 && <span class="text-muted">, </span>}
                                <a class="text-accent hover:underline" href={`#${s}`}>
                                  {glossary.get(s)!.term}
                                </a>
                              </>
                            ))}
                          </span>
                        )}
                      </div>
                    )}
                  </article>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .gl-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .gl-chip:hover {
    color: var(--text);
  }
  .gl-chip[aria-pressed='true'] {
    border-color: var(--chip, var(--accent));
    color: var(--text);
    background: color-mix(in srgb, var(--chip, var(--accent)) 14%, var(--surface));
  }
  .gl-letter {
    display: inline-grid;
    place-items: center;
    min-width: 1.6rem;
    height: 1.6rem;
    border-radius: 0.35rem;
    color: var(--accent);
    font-weight: 600;
  }
  a.gl-letter:hover {
    background: var(--accent-soft);
  }
  .gl-letter-off,
  .gl-letter[data-empty] {
    color: var(--border);
    font-weight: 400;
    pointer-events: none;
  }
  .gl-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    padding: 0.05em 0.3em;
  }
  .gl-body :global(strong) {
    font-weight: 650;
  }
  .gl-card {
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .gl-card:has(:target) {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent);
    background: color-mix(in srgb, var(--accent) 5%, var(--surface));
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-glossary-filter]')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-term-card]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-letter-section]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-module-chip]')];
  const count = document.querySelector<HTMLElement>('[data-glossary-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-glossary-empty]')!;
  let module = '';

  function apply() {
    const words = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const c of cards) {
      const ok = (!module || c.dataset.module === module) && words.every((w) => c.dataset.search!.includes(w));
      c.hidden = !ok;
      if (ok) shown++;
    }
    for (const s of sections) {
      const any = s.querySelector('[data-term-card]:not([hidden])');
      s.hidden = !any;
      const link = document.querySelector<HTMLElement>(`[data-letter-link="${s.dataset.letterSection}"]`);
      if (link) link.toggleAttribute('data-empty', !any);
    }
    count.textContent = shown === cards.length ? `${cards.length} terms` : `${shown} of ${cards.length} terms`;
    empty.hidden = shown > 0;
    empty.classList.toggle('hidden', shown > 0);
  }

  input.addEventListener('input', apply);
  for (const chip of chips)
    chip.addEventListener('click', () => {
      module = chip.dataset.moduleChip ?? '';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      apply();
    });
  document.querySelector('[data-glossary-clear]')?.addEventListener('click', () => {
    input.value = '';
    module = '';
    chips.forEach((c, i) => c.setAttribute('aria-pressed', String(i === 0)));
    apply();
    input.focus();
  });
  // "/" focuses the filter (unless already typing somewhere).
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '/' && !e.ctrlKey && !e.metaKey && !/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) && !t.isContentEditable) {
      e.preventDefault();
      input.focus();
    }
  });
  // Restore a filter from ?q= (handy for links from elsewhere).
  const q = new URLSearchParams(location.search).get('q');
  if (q) {
    input.value = q;
    apply();
  }
</script>
