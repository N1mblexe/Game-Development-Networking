---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="Not found">
  <div class="py-20 text-center">
    <p class="font-mono text-6xl font-bold text-muted">404</p>
    <h1 class="mt-4 text-2xl font-bold">This packet was lost.</h1>
    <p class="mt-2 text-muted">The page you asked for doesn't exist, and nobody is going to retransmit it.</p>
    <a class="btn btn-primary mt-6" href={withBase('/')}>Back to the course</a>
  </div>
</BaseLayout>
