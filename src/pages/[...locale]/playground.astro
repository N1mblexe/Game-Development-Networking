---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SimHost from '../../components/sim/SimHost';
import { sims } from '../../components/sim/registry';
import { getLesson, lessonUrlFromKey } from '../../lib/content/nav';
import { getLocale, localeStaticPaths } from '../../lib/i18n/route';
import { simText } from '../../lib/i18n/registry';

export const getStaticPaths = () => localeStaticPaths();
const locale = getLocale(Astro);

// Everything in the registry shows up here automatically.
const entries = await Promise.all(
  Object.entries(sims).map(async ([name, def]) => ({
    name,
    title: simText(name, locale).title,
    lessons: (await Promise.all(def.lessons.map((k) => getLesson(k, locale)))).filter((l) => l !== undefined),
  })),
);
---

<BaseLayout title="Playground" wide>
  <h1 class="mb-2 text-3xl font-extrabold tracking-tight">Simulator playground</h1>
  <p class="mb-6 text-muted">Every simulator from the course in one place. Change the network and see what breaks.</p>
  <nav class="mb-8 flex flex-wrap gap-2" aria-label="Simulators">
    {entries.map((e) => <a class="rounded-full bg-surface-2 px-3 py-1 text-sm hover:text-accent" href={`#${e.name}`}>{e.title}</a>)}
  </nav>
  {
    entries.map((e) => (
      <section id={e.name} class="scroll-mt-20">
        <SimHost client:visible name={e.name} locale={locale} />
        {e.lessons.length > 0 && (
          <p class="-mt-5 mb-10 text-sm text-muted">
            Used in: {e.lessons.map((l, i) => (<>{i > 0 && ', '}<a class="text-accent underline" href={lessonUrlFromKey(l.id, locale)}>{l.data.title}</a></>))}
          </p>
        )}
      </section>
    ))
  }
</BaseLayout>
