---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ProgressDot from '../../../../components/layout/ProgressDot.astro';
import FlashcardDeck from '../../../../components/srs/FlashcardDeck';
import { getLocale, localeStaticPaths } from '../../../../lib/i18n/route';
import { certificateUrl, examUrl, getExam, getFlashcards, getLessons, getModule, getModules, lessonUrl, moduleUrl, pageUrl } from '../../../../lib/content/nav';

export async function getStaticPaths() {
  return localeStaticPaths((await getModules()).map((m) => ({ params: { module: m.id } })));
}

const locale = getLocale(Astro);
const module = (await getModule(Astro.params.module!, locale))!;
const d = module.data;
const lessons = await getLessons(module.id, locale);
const exam = await getExam(module.id, locale);
const cards = await getFlashcards(module.id, locale);
const totalMin = lessons.reduce((s, l) => s + l.data.durationMin, 0);
const prereqModules = (await getModules(locale)).filter((m) => d.prerequisites.includes(m.id));
---

<BaseLayout title={d.title} description={d.summary} accent={d.color}>
  <header class="mb-10">
    <div class="mb-4 flex items-center gap-3">
      <span class="bg-module-solid grid h-12 w-12 place-items-center rounded-xl text-lg font-bold" style={`--module:${d.color}`}>{d.badge}</span>
      <div>
        <p class="text-sm text-muted">Module {d.order}</p>
        <h1 class="text-3xl font-extrabold tracking-tight">{d.title}</h1>
      </div>
    </div>
    <p class="max-w-3xl text-lg text-muted">{d.summary}</p>
    <p class="mt-3 text-sm text-muted">
      {lessons.length} lessons · about {Math.round(totalMin / 6) / 10} h
      {prereqModules.length > 0 && <> · start after {prereqModules.map((m, i) => (<>{i > 0 && ', '}<a class="text-accent underline" href={moduleUrl(m.id, locale)}>{m.data.title}</a></>))}</>}
    </p>
    <div class="mt-5 max-w-md" data-module-progress data-lesson-keys={lessons.map((l) => l.id).join(',')}>
      <div class="h-2 overflow-hidden rounded-full bg-surface-2">
        <div class="h-full rounded-full transition-[width]" style="width: var(--pct, 0%); background: var(--module)"></div>
      </div>
      <p class="mt-1 text-sm text-muted" data-progress-text>0/{lessons.length} lessons</p>
    </div>
  </header>

  <ol class="grid gap-3">
    {
      lessons.map((l, i) => (
        <li class="min-w-0">
          <a href={lessonUrl(l, locale)} class="card flex gap-4 p-4 hover:border-accent">
            <span class="w-6 shrink-0 text-right font-mono text-muted">{i + 1}</span>
            <span class="min-w-0 flex-1 [overflow-wrap:anywhere]">
              <span class="block font-semibold">{l.data.title}</span>
              <span class="block text-sm text-muted">{l.data.summary}</span>
            </span>
            <span class="hidden shrink-0 text-sm text-muted sm:block">{l.data.durationMin} min</span>
            <ProgressDot lessonKey={l.id} />
          </a>
        </li>
      ))
    }
  </ol>

  <section class="mt-10 grid gap-4 sm:grid-cols-2">
    <div class="card p-5">
      <h2 class="text-lg font-bold">🎓 Module exam</h2>
      {
        exam ? (
          <>
            <p class="mt-1 text-sm text-muted">
              {exam.data.drawCount} questions drawn from a pool of {exam.data.questions.length}. Pass at {exam.data.passPct}% to earn the certificate.
            </p>
            <p class="mt-2 text-sm font-semibold" data-exam-status={module.id}>Not attempted</p>
            <div class="mt-4 flex gap-2">
              <a class="btn btn-primary" href={examUrl(module.id, locale)}>Take the exam</a>
              <a class="btn" href={certificateUrl(module.id, locale)}>Certificate</a>
            </div>
          </>
        ) : (
          <p class="mt-1 text-sm text-muted">Exam coming soon.</p>
        )
      }
    </div>
    <div class="card p-5">
      <h2 class="text-lg font-bold">🗂 Flashcards</h2>
      <p class="mt-1 text-sm text-muted">{cards.length} cards in this module.</p>
      <p class="mt-2 text-sm font-semibold" data-cards-due data-card-ids={cards.map((c) => c.globalId).join(',')}></p>
      <a class="btn mt-4" href={pageUrl(`/review/?module=${module.id}`, locale)}>Review this module</a>
    </div>
  </section>

  {
    cards.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-4 text-xl font-bold">Browse the cards</h2>
        <FlashcardDeck client:visible cards={cards} locale={locale} />
      </section>
    )
  }
</BaseLayout>
