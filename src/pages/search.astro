---
/**
 * Full-page search (the header also opens a Ctrl/⌘+K modal). Supports ?q=term.
 * Uses the default Pagefind instance; the modal uses its own "modal" instance.
 */
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search every lesson and glossary term.">
  <div class="mx-auto max-w-4xl">
    <h1 class="mb-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Search</h1>
    <p class="mb-6 text-muted">
      Lessons and glossary terms. Tip: press <kbd class="rounded border border-border bg-surface-2 px-1.5 text-xs">Ctrl K</kbd> on any page.
    </p>

    <PagefindConfig excerpt-length="30" />
    <div class="nl-search-page">
      <pagefind-input placeholder="Search lessons and the glossary…" autofocus debounce="150"></pagefind-input>
      <div class="mt-6 grid gap-6 md:grid-cols-[12rem_minmax(0,1fr)]">
        <aside aria-label="Filters">
          <pagefind-filter-pane open="module" sort="alphabetical"></pagefind-filter-pane>
        </aside>
        <div class="min-w-0">
          <pagefind-summary default-message="Type to search."></pagefind-summary>
          <pagefind-results max-sub-results="4"></pagefind-results>
        </div>
      </div>
    </div>
    <noscript><p class="mt-4 text-sm text-muted">Search needs JavaScript. Browse the course from the home page instead.</p></noscript>
  </div>
</BaseLayout>

<style>
  .nl-search-page :global(pagefind-results) {
    margin-top: 0.75rem;
  }
</style>

<script>
  // Prefill from ?q= once the input component has rendered.
  const q = new URLSearchParams(location.search).get('q');
  if (q) {
    customElements.whenDefined('pagefind-input').then(() => {
      const tryFill = (n = 0) => {
        const input = document.querySelector<HTMLInputElement>('.nl-search-page pagefind-input input');
        if (!input) return n < 40 && setTimeout(() => tryFill(n + 1), 50);
        input.value = q;
        input.dispatchEvent(new Event('input', { bubbles: true }));
      };
      tryFill();
    });
  }
</script>
