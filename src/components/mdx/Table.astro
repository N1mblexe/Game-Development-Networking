---
/**
 * Replaces Markdown tables in lessons. Wide tables scroll sideways inside a focusable region, so keyboard
 * users can scroll them too (axe: scrollable-region-focusable), and the page itself never overflows.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'table'>;
---

<div class="table-scroll" tabindex="0" role="region" aria-label="Table (scrollable)">
  <table {...Astro.props}><slot /></table>
</div>
